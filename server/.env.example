# SnippetVault — Server Environment Variables
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin — used for CORS allowed origin
# In development this is the Vite dev server.
# In production set this to your deployed frontend URL.
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
# Replace with your actual connection string from MongoDB Atlas.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/snippetvault?retryWrites=true&w=majority

# JWT
# Replace with a long, random, secret string.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Gemini API (server-side only — never expose to the browser)
GEMINI_API_KEY=replace_with_your_gemini_api_key
